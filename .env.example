# Optional StreamFree overrides (keyless; primary catalog since Streamed closed).
# STRMFREE_BASE_URL=https://strmfree.st/
# STRMFREE_CACHE_TTL_MS=60000

# Optional PPV overrides.
# PPV_BASE_URL=https://api.ppv.st/
# PPV_CACHE_TTL_MS=60000

# Both providers always use native video. VITE_HLS_NATIVE and VITE_EMBED_PROXY
# no longer control playback; provider iframe fallback is disabled.

# Headless HLS resolver: ignore embed.st TLS date errors (default on). Set 0 to enforce.
# HLS_IGNORE_TLS=1
