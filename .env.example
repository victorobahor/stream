# Optional SportSRC V1 overrides (keyless by default).
# SPORTSRC_API_KEY=
# SPORTSRC_BASE_URL=https://api.sportsrc.org/
# SPORTSRC_CACHE_TTL_MS=30000

# Optional: force all embeds through /__embed (breaks embed.st WASM — leave off).
# VITE_EMBED_PROXY=0

# Native HLS for Streamed embed.st (default on). Set 0 to force iframe.
# VITE_HLS_NATIVE=1
